generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model attending_events {
  id       Int    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id  Int
  event_id String @db.VarChar(45)
}

model audience_count {
  id              Int    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  event_id        String @db.VarChar(45)
  current_count   String @db.VarChar(45)
  remaining_count String @db.VarChar(45)
  bool_featured   String @db.VarChar(45)
}

model create_events {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String   @db.VarChar(250)
  category   String   @db.VarChar(20)
  descrip    String   @db.VarChar(500)
  img        String?  @db.VarChar(500)
  location   String   @db.VarChar(500)
  pax        Int
  org_name   String   @db.VarChar(250)
  org_email  String   @db.VarChar(250)
  org_phone  String   @db.VarChar(10)
  start_date DateTime @db.DateTime(0)
  end_date   DateTime @db.DateTime(0)
  fares      String   @db.VarChar(15)
  e_status   String   @db.VarChar(10)
  tags       String   @db.VarChar(30)

  @@index([user_id], map: "fk_createevents_user")
}

model history_events {
  id       Int    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  user_id  Int
  event_id String @db.VarChar(45)
}

model interested_events {
  id       Int    @id @default(autoincrement())
  user_id  Int
  event_id String @db.VarChar(45)
}

model user {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(30)
  email      String  @unique(map: "email_UNIQUE") @db.VarChar(100)
  password   String  @db.VarChar(100)
  mfa_secret String? @db.VarChar(400)
}
